{
  "expo": {
    "name": "Echo",
    "slug": "blankslate-react-native",
    "scheme": "blankslate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d57a00cc-ae38-427d-a75f-1f5bb37162c4",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Echo uses photos you choose for your profile and posts.",
          "cameraPermission": "Echo uses the camera so you can photograph food to estimate nutrients."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Echo uses the microphone so you can speak a set to log it.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-mail-composer",
      "expo-video",
      "expo-asset",
      "expo-document-picker",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Echo uses the camera so you can photograph food and profile photos.",
          "microphonePermission": "Echo uses the microphone when recording video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Echo can use your location for gym check-ins and nearby features."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Echo can add habit reminders to your calendar."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Echo can save and read photos you choose for posts and food logs.",
          "savePhotosPermission": "Echo can save images to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Echo can use Face ID to protect your account on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.purushottam.gymrats",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.purushottam.gymrats",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d57a00cc-ae38-427d-a75f-1f5bb37162c4"
      }
    },
    "owner": "purushottamdafures-team"
  }
}
