{
  "name": "blankslate-react-native",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node --experimental-strip-types --test src/lib/devHost.test.ts src/lib/fileId.test.ts src/lib/foodDelete.test.ts src/lib/liftCards.test.ts src/lib/liftDelete.test.ts src/lib/localDate.test.ts src/lib/measure.test.ts src/lib/nextSetAttempt.test.ts src/lib/nutrition.test.ts src/lib/ordinal.test.ts src/lib/relativeTime.test.ts src/lib/setOrder.test.ts src/lib/voiceSet.test.ts src/lib/weekday.test.ts src/theme/appearancePreference.test.ts",
    "update:configure": "eas-cli update:configure",
    "update:preview": "eas-cli update --channel preview --environment preview",
    "update:production": "eas-cli update --channel production --environment production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "^1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
