SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Edge Functions — local runtime loads this via [edge_runtime.secrets] in config.toml.
# Required for add_set_from_voice. Hosted: supabase secrets set OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=

# Optional — only when enabling Google or SMS in config.toml.
# Tests and lint do not need these.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
